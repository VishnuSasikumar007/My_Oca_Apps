<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="pos_sales_dashboard.Template" owl="1">

        <div class="o_pos_dashboard container-fluid" t-attf-class="{{ state.dark_mode ? 'dark-mode' : '' }}">

            <!-- ================= TOP USER ROW ================= -->

            <div class="top-user-bar">

                <div class="dashboard-datetime">
                   <!--  <i class="fa fa-clock-o"></i>
                    <span t-esc="state.current_datetime"/> -->
                </div>

                <div class="top-user-right">

                    <!-- NOTIFICATION -->


                    <t t-if="state.has_new_orders">
                       <div class="new-order-indicator">
                            <i class="fa fa-bell bell-animate"></i>

                            <span class="new-order-text">
                                New Orders Available
                            </span>

                            <button class="refresh-btn"
                                    t-on-click="refreshDashboard">
                                <i class="fa fa-refresh"/>
                            </button>
                        </div>
                    </t>
                    <div class="notification-icon">

                        <i class="fa fa-bell" t-on-click="toggleNotifications"/>

                        <span class="notification-badge" t-if="state.notification_count">
                            <t t-esc="state.notification_count"/>
                        </span>

                        <div class="notification-dropdown" t-if="state.showNotifications">

                            <div class="notification-title">

                                Latest Orders

                                <span class="mark-read" t-on-click="markNotificationsRead">
                                    Mark as read
                                </span>

                            </div>

                            <div class="notification-list">

                                <t t-foreach="state.notifications" t-as="n" t-key="n[0]">

                                    <div class="notification-item">

                                        <span class="order-ref">
                                            <t t-esc="n[0]"/>
                                        </span>

                                        <span class="order-amount">
                                            <t t-esc="state.currency.symbol"/> <t t-esc="n[1]"/>
                                        </span>

                                    </div>

                                </t>

                            </div>

                        </div>

                    </div>

                    <!-- DARK MODE TOGGLE -->

                    <div class="theme-toggle">

                        <button class="theme-btn" t-on-click="toggleTheme">

                            <t t-if="state.dark_mode">
                                <i class="fa fa-sun-o sun-icon"></i>
                            </t>

                            <t t-else="">
                                <i class="fa fa-moon-o moon-icon"></i>
                            </t>

                        </button>

                    </div>

                    <!-- USER PROFILE -->

<!-- <div class="user-profile" t-if="state.user">

<img class="user-avatar" t-att-src="state.user.image"/>

<span class="user-name">
<t t-esc="state.user.name"/>
</span>

</div> -->

</div>

</div>

<!-- ================= SECOND HEADER ================= -->

<div class="dashboard-header">

    <h2 class="dashboard-title">POS Analytics</h2>

    <div class="session-filter">

        <i class="fa fa-desktop session-icon"></i>

        <select class="session-dropdown"
            t-on-change="changeSession">

            <option t-att-selected="state.selected_session === null" value="">
                All Sessions
            </option>

            <t t-foreach="state.all_sessions" t-as="s" t-key="s.id">

                <option t-att-value="s.id"
                    t-att-selected="state.selected_session === s.id">

                    <t t-esc="s.name"/> 
                </option>

            </t>

        </select>

    </div>

    <div class="filter-buttons">

        <button t-on-click="changeFilter"
            data-filter="yesterday"
            t-att-class="'filter-btn ' + (state.filter === 'yesterday' ? 'active' : '')">
            Yesterday
        </button>


        <button t-on-click="changeFilter"
            data-filter="today"
            t-att-class="'filter-btn ' + (state.filter === 'today' ? 'active' : '')">
            Today
        </button>

        <button t-on-click="changeFilter"
            data-filter="week"
            t-att-class="'filter-btn ' + (state.filter === 'week' ? 'active' : '')">
            Last 7 Days
        </button>

        <button t-on-click="changeFilter"
            data-filter="month"
            t-att-class="'filter-btn ' + (state.filter === 'month' ? 'active' : '')">
            This Month
        </button>

        <button t-on-click="changeFilter"
            data-filter="year"
            t-att-class="'filter-btn ' + (state.filter === 'year' ? 'active' : '')">
            This Year
        </button>

    </div>

</div>


<!-- ================= KPI CARDS ================= -->

<div class="kpi-grid">

    <div class="kpi-card kpi-blue">
        <div class="kpi-title">Total Sales</div>
        <div class="kpi-value"><t t-esc="state.currency.symbol"/> <t t-esc="state.sales"/></div>
    </div>

    <div class="kpi-card kpi-green">
        <div class="kpi-title">Top Product</div>
        <div class="kpi-value">
            <t t-if="state.products.length">
                <t t-esc="state.products[0][0]"/>
            </t>
        </div>
    </div>

    <div class="kpi-card kpi-yellow">
        <div class="kpi-title">Total Stores</div>
        <div class="kpi-value">
            <t t-esc="state.stores.length"/>
        </div>
    </div>

    <div class="kpi-card kpi-red">
        <div class="kpi-title">Total Orders</div>
        <div class="kpi-value">
            <t t-esc="state.total_order_count"/>
        </div>
    </div>

</div>


<!-- ================= DATA GRID ================= -->

<div class="data-grid">

    <!-- ACTIVE SESSIONS -->

    <div class="data-card" >

        <div class="data-title">🟢 Active POS Sessions</div>

        <table class="modern-table">

            <thead>
                <tr>
                    <th>S.No.</th>
                    <th>Session</th>
                    <th>Cashier</th>
                    <th>Store</th>
                    <th>Opening Date</th>
                </tr>
            </thead>

            <tbody>
                 <t t-set="as_sno" t-value="1"/>
                <t t-foreach="state.sessions.slice(0,5)" t-as="s" t-key="s.id">

                    <tr>
                        <td><t t-esc="as_sno"/></td>
                        <td><t t-esc="s.name"/></td>
                        <td><t t-esc="s.user"/></td>
                        <td><t t-esc="s.config"/></td>
                        <td><t t-esc="s.start_at"/></td>
                    </tr>
                    <t t-set="as_sno" t-value="as_sno + 1"/>

                </t>

            </tbody>

        </table>

        <!-- VIEW MORE BUTTON -->

        <div class="session-more" t-if="state.sessions.length &gt; 5">

            <button class="more-btn" t-on-click="openSessionPopup">

                View More (<t t-esc="state.sessions.length - 5"/>)

            </button>

        </div>

        <!-- SESSION STATUS SUMMARY -->

        <div class="payment-summary">

            <!-- <div class="payment-title">Session Status</div> -->

            <div class="payment-methods">

                <!-- OPEN SESSIONS -->

