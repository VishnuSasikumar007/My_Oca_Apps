<t t-if="state.filter === 'month' or state.filter === 'year'">

    <div class="data-card">

        <div class="data-title">
            📊 Store Sales Comparison
        </div>

        <div class="product-chart-container">
            <canvas id="storeComparisonChart"></canvas>
        </div>

    </div>

</t>

<!-- TOP PRODUCTS -->

<div class="data-card glass-card">

    <div class="data-title top-product-header">

        <span>🔥 Top Selling Products</span>
        <t t-if="!state.showProductChart">
            <!-- SEARCH INPUT -->
            <input type="text"
             class="product-search"
             placeholder="Search product..."
             t-on-input="onProductSearch"/>
         </t>

         <button class="chart-toggle-btn"
            t-on-click="toggleProductChart">

            <t t-if="state.showProductChart">
                <i class="fa fa-list" title="Show List View"></i>
            </t>

            <t t-else="">
                <i class="fa fa-bar-chart" title="Show Bar Chart"></i>
            </t>

        </button>

    </div>

    <t t-if="!state.showProductChart">

        <table class="modern-table">

            <thead>
                <tr>
                    <th>S.No.</th>
                    <th>Product</th>
                    <th>Qty</th>
                    <th>History</th>
                </tr>
            </thead>

            <tbody>
                <t t-set="sno" t-value="1"/>
                <t t-foreach="state.filtered_products.slice(0,5)" t-as="p" t-key="p[2]">

                    <tr>
                        <td><t t-esc="sno"/></td>
                        <td><t t-esc="p[0]"/></td>

                        <td>
                            <span class="qty-pill">
                                <t t-esc="p[1]"/>
                            </span>
                        </td>

                        <td>

                            <button class="view-btn"
                                t-on-click="openProductDetails"
                                t-att-data-product="p[2]">
                                View
                            </button>

                        </td>

                    </tr>
                     <t t-set="sno" t-value="sno + 1"/>

                </t>

            </tbody>

        </table>

    </t>

    <!-- BAR CHART VIEW -->

    <t t-if="state.showProductChart">

        <div class="product-chart-container">

            <canvas id="productChart"  title="Bar Chart"></canvas>

        </div>

    </t>

    <!-- VIEW MORE BUTTON -->
    <t t-if="!state.showProductChart">
        <div class="session-more" t-if="state.products.length &gt; 5">

            <button class="more-btn" t-on-click="openProductPopup">

                View More (<t t-esc="state.products.length - 5"/>)

            </button>

        </div>
    </t>

</div>

<!-- STORE PERFORMANCE -->

<div class="data-card">

    <div class="data-title top-product-header">

        <span>📊 Store Perfomance</span>

        <button class="chart-toggle-btn"
            t-on-click="toggleStoreChart">

            <t t-if="state.showStoreChart">
                <i class="fa fa-list" title="Show List View"></i>
            </t>

            <t t-else="">
                <i class="fa fa-pie-chart" title="Show Pie Chart"></i>
            </t>

        </button>

    </div>

    <!-- TABLE VIEW -->

    <t t-if="!state.showStoreChart">

        <table class="modern-table">

            <thead>
                <tr>
                    <th t-if="!state.selected_session">Rank</th>
                    <th>Store</th>
                    <th>Orders</th>
                    <th>Sales</th>
                </tr>
            </thead>

            <tbody>

                <t t-set="rank" t-value="1"/>

                <t t-foreach="state.stores.slice(0,6)" t-as="s" t-key="s[0]">

                    <tr>

                        <td t-if="!state.selected_session">
                            <t t-esc="rank"/>
                        </td>

                        <td>
                            <t t-esc="s[0]"/>
                        </td>

                        <td>
                            <t t-esc="s[1]"/> Orders
                        </td>

                        <td class="sales-value">
                            <t t-esc="state.currency.symbol"/> <t t-esc="s[2]"/>
                        </td>

                    </tr>

                    <t t-set="rank" t-value="rank + 1"/>

                </t>

            </tbody>

        </table>

    </t>

    <!-- PIE CHART VIEW -->

    <t t-if="state.showStoreChart">

        <div class="product-chart-container">

            <canvas id="storeChart" title="Pie Chart"></canvas>

        </div>

    </t>

    <!-- VIEW MORE -->
    <t t-if="!state.showStoreChart">
        <div class="session-more" t-if="state.stores.length > 3">

            <button class="more-btn"
                t-on-click="openStorePopup">

                View More (<t t-esc="state.stores.length - 3"/>)

            </button>

        </div>
    </t>


    <div class="payment-summary">

        <div class="payment-title">Payment Methods</div>

        <div class="payment-methods">

            <t t-foreach="state.payments" t-as="p" t-key="p[0]">

                <div class="payment-pill"
     t-on-click="openPaymentDetails"
     t-att-data-payment="p[0]"
     style="cursor:pointer;">

                    <span class="payment-icon">

                        <i t-if="p[0].toLowerCase() == 'cash'" class="fa fa-money"/>
                        <i t-if="p[0].toLowerCase() == 'card'" class="fa fa-credit-card"/>
                        <i t-if="p[0].toLowerCase() == 'upi'" class="fa fa-mobile"/>
                        <i t-if="p[0].toLowerCase() == 'customer account'" class="fa fa-user-circle"/>

                        <i t-if="p[0].toLowerCase() != 'cash' 
                            and p[0].toLowerCase() != 'card' 
                            and p[0].toLowerCase() != 'upi'
                            and p[0].toLowerCase() != 'customer account'" 
                            class="fa fa-wallet"/>

                        </span>

                        <span class="payment-name">
                            <t t-esc="p[0]"/>
                        </span>

                        <span class="payment-value">
                            <t t-esc="state.currency.symbol"/> <t t-esc="p[1]"/>
                        </span>

                    </div>

                </t>

            </div>
        </div>

    </div>


    <!-- TOP CUSTOMERS -->

    <div class="data-card">

        <div class="data-title">⭐ Top Customers</div>

        <table class="modern-table">

            <thead>
                <tr>
                    <th>S.No.</th>
                    <th>Customer</th>
                    <th>Sales</th>
                </tr>
            </thead>

            <tbody>
                 <t t-set="ts_sno" t-value="1"/>

                <t t-foreach="state.customers.slice(0,5)" t-as="c" t-key="c[0]">

                    <tr>
                        <td>
                                <t t-esc="ts_sno"/>
                            </td>

                        <!-- CUSTOMER WITH IMAGE -->
                        <td style="display:flex; align-items:center; gap:10px;">

                            

                            <div class="customer-img-wrapper">

                                <img t-att-src="'/web/image/res.partner/' + c[0] + '/image_128'"
                                   class="customer-avatar"/>

                                   <!-- ZOOM IMAGE -->
                                   <img t-att-src="'/web/image/res.partner/' + c[0] + '/image_128'"
                                       class="customer-zoom"/>

                                   </div>

                                   <span>
                                    <t t-esc="c[1]"/>
                                </span>

                            </td>
                            <!-- SALES -->
                            <td class="sales-value">
                                <t t-esc="state.currency.symbol"/> <t t-esc="c[2]"/>
                            </td>

                        </tr>
                        <t t-set="ts_sno" t-value="ts_sno + 1"/>

                    </t>

                </tbody>

            </table>

            <div class="session-more" t-if="state.customers.length > 5">

                <button class="more-btn" t-on-click="openCustomerPopup">

                    View More (<t t-esc="state.customers.length - 5"/>)

                </button>

            </div>

        </div>

        <div class="data-card">

            <div class="top-product-header">
                <div class="data-title">📦 Top POS Product Categories</div>
            </div>

            <table class="modern-table">

                <thead>
                    <tr>
                        <th>S.No.</th>
                        <th>Category</th>
                        <th>Qty</th>
                        <th>History</th>
                    </tr>
                </thead>

                <tbody>
                    <t t-set="tpc_sno" t-value="1"/>
                    <t t-foreach="state.categories.slice(0,5)" t-as="cat" t-key="cat.id">

                        <tr>

                            <td>
                                <t t-esc="tpc_sno"/>
                            </td>

                             <td>
                                <t t-esc="cat.name"/>
                            </td>

                            <td>
                                <span class="qty-pill">
                                    <t t-esc="cat.qty"/>
                                </span>
                            </td>

                            <td>

                                <button class="view-btn"
                                    t-on-click="openCategoryProducts"
                                    t-att-data-category="cat.id">

                                    View

                                </button>

                            </td>

                        </tr>
                        <t t-set="tpc_sno" t-value="tpc_sno + 1"/>

                    </t>

                </tbody>
            </table>

            <!-- VIEW MORE BUTTON -->

            <div class="session-more" t-if="state.categories and state.categories.length > 5">

                <button class="more-btn" t-on-click="openCategoryPopup">

                    View More (<t t-esc="state.categories.length - 5"/>)

                </button>

            </div>

        </div>

          <!-- TOP CASHIERS -->

<div class="data-card">

    <div class="data-title top-product-header">

        <span>👨‍💼 Top Cashiers</span>

    </div>

    <table class="modern-table">

        <thead>
            <tr>
                <th>Rank</th>
                <th>Cashier</th>
                <th>Orders</th>
                <th>Sales</th>
            </tr>
        </thead>

        <tbody>

            <t t-foreach="state.top_cashiers.slice(0,5)" t-as="c" t-key="c.id">

                <tr>

                    <td>
                        <t t-esc="c.rank"/>
                    </td>
                   <td style="display:flex; align-items:center; gap:10px;">

                        <div class="customer-img-wrapper">

                            <!-- Small image -->
                            <img t-att-src="'/web/image/hr.employee/' + c.id + '/image_128'"
                                 class="customer-avatar"/>

                            <!-- Zoom image -->
                            <img t-att-src="'/web/image/hr.employee/' + c.id + '/image_128'"
                                 class="customer-zoom"/>

                        </div>

                        <span>
                            <t t-esc="c.name"/>
                        </span>

                    </td>

                    <td>
                        <t t-esc="c.orders"/> Orders
                    </td>

                    <td class="sales-value">
                        <t t-esc="state.currency.symbol"/> 
                        <t t-esc="c.sales"/>
                    </td>

                </tr>

            </t>

        </tbody>

    </table>

    <!-- VIEW MORE BUTTON -->

    <div class="session-more" t-if="state.top_cashiers.length > 5">

        <button class="more-btn" t-on-click="openCashierPopup">

            View More (<t t-esc="state.top_cashiers.length - 5"/>)

        </button>

    </div>

</div>

    </div>

  


    <t t-if="state.showProductPopup">

        <div class="session-popup-overlay" t-on-click="closeProductPopup">

            <div class="session-popup" t-on-click.stop="">

                <div class="popup-header">

                    <span>All Top Selling Products</span>
                    <button class="popup-close" t-on-click="closeProductPopup">
                        ✕
                    </button>

                </div>

                <table class="modern-table">

                    <thead>
                        <tr>
                            <th>S.No.</th>
                            <th>Product</th>
                            <th>Qty</th>
                        </tr>
                    </thead>

                    <tbody>
                         <t t-set="tsno" t-value="1"/>

                        <t t-foreach="state.products.slice(5)" t-as="p" t-key="p[0]">

                            <tr>
                                <td><t t-esc="tsno"/></td>

                                <td><t t-esc="p[0]"/></td>

                                <td>
                                    <span class="qty-pill">
                                        <t t-esc="p[1]"/>
                                    </span>
                                </td>

                            </tr>
                            <t t-set="tsno" t-value="tsno + 1"/>

                        </t>

                    </tbody>

                </table>

            </div>

        </div>

    </t>


    <!-- SESSION POPUP -->

    <t t-if="state.showSessionPopup">

        <div class="session-popup-overlay" t-on-click="closeSessionPopup">

            <div class="session-popup" t-on-click.stop="">

                <div class="popup-header">

                    <span>All Active Sessions</span>

                    <button class="popup-close" t-on-click="closeSessionPopup">
                        ✕
                    </button>

                </div>

                <table class="modern-table">

                    <thead>
                        <tr>
                            <th>S.No.</th>
                            <th>Session</th>
                            <th>Cashier</th>
                            <th>Store</th>
                            <th>Opening Date</th>
                        </tr>
                    </thead>

                    <tbody>
                        <t t-set="aas_sno" t-value="1"/>
                        <t t-foreach="state.sessions.slice(5)" t-as="s" t-key="s.id">

                            <tr>
                                <td><t t-esc="aas_sno"/></td>
                                <td><t t-esc="s.name"/></td>
                                <td><t t-esc="s.user"/></td>
                                <td><t t-esc="s.config"/></td>
                                <td><t t-esc="s.start_at"/></td>
                            </tr>
                            <t t-set="aas_sno" t-value="aas_sno + 1"/>

                        </t>

                    </tbody>

                </table>

            </div>

        </div>

    </t>
    <!-- product sales details popup -->
    <t t-if="state.showProductDetails">

        <div class="session-popup-overlay" t-on-click="closeProductDetails">

            <div class="session-popup" t-on-click.stop="">

                <div class="popup-header">

                    <span>Product Sales Details</span>

                    <button class="popup-close" t-on-click="closeProductDetails">
                        ✕
                    </button>

                </div>

                <table class="modern-table">

                    <thead>
                        <tr>
                            <th>S.No.</th>
                            <th>Order</th>
                            <th>Date</th>
                            <th>Qty</th>
                            <th>Unit Price</th>
                            <th>Total</th>
                        </tr>
                    </thead>

                    <tbody>

                        <t t-set="psd_sno" t-value="1"/>

                        <t t-foreach="state.product_details" t-as="d" t-key="d.id">

                            <tr>

                                 <td>
                                    <t t-esc="psd_sno"/>
                                </td>

                                <td>
                                    <t t-esc="d.order"/>
                                </td>

                                <td>
                                    <t t-esc="d.date"/>
                                </td>

                                <td>
                                    <t t-esc="d.qty"/>
                                </td>

                                <td>
                                    <t t-esc="state.currency.symbol"/> <t t-esc="d.price"/>
                                </td>

                                <td class="sales-value">
                                    <t t-esc="state.currency.symbol"/> <t t-esc="d.total"/>
                                </td>

                            </tr>
                            <t t-set="psd_sno" t-value="psd_sno + 1"/>

                        </t>

                    </tbody>

                </table>

            </div>

        </div>

    </t>


    <!-- store performance popup -->

    <t t-if="state.showStorePopup">

        <div class="session-popup-overlay" t-on-click="closeStorePopup">

            <div class="session-popup" t-on-click.stop="">

                <div class="popup-header">

                    <span>All Store Performance</span>

                    <button class="popup-close"
                        t-on-click="closeStorePopup">
                        ✕
                    </button>

                </div>

                <table class="modern-table">

                    <thead>
                        <tr>
                            <th>Rank</th>
                            <th>Store</th>
                            <th>Orders</th>
                            <th>Sales</th>
                        </tr>
                    </thead>

                    <tbody>

                        <t t-set="rank" t-value="4"/>

                        <t t-foreach="state.stores.slice(3)" t-as="s" t-key="s[0]">

                            <tr>

                                <td>
                                    <t t-esc="rank"/>
                                </td>

                                <td>
                                    <t t-esc="s[0]"/>
                                </td>

                                <td>
                                    <t t-esc="s[1]"/> Orders
                                </td>

                                <td class="sales-value">
                                    <t t-esc="state.currency.symbol"/> <t t-esc="s[2]"/>
                                </td>

                            </tr>

                            <t t-set="rank" t-value="rank + 1"/>

                        </t>

                    </tbody>

                </table>

            </div>

        </div>

    </t>

    <!-- product ranking popup -->
    <t t-if="state.showStoreRankingPopup">

        <div class="session-popup-overlay" t-on-click="closeStoreRankingPopup">

            <div class="session-popup" t-on-click.stop="">

                <div class="popup-header">

                    <span>All Store Rankings</span>

                    <button class="popup-close"
                        t-on-click="closeStoreRankingPopup">
                        ✕
                    </button>

                </div>

                <table class="modern-table">

                    <thead>
                        <tr>
                            <th>Rank</th>
                            <th>Store</th>
                            <th>Orders</th>
                            <th>Sales</th>
                        </tr>
                    </thead>

                    <tbody>

                        <t t-foreach="state.store_ranking.slice(3)" t-as="s" t-key="s.store + s.rank">

                            <tr>

                                <td>
                                    <t t-esc="s.rank"/>
                                </td>

                                <td>
                                    <t t-esc="s.store"/>
                                </td>

                                <td>
                                    <t t-esc="s.orders"/>
                                </td>

                                <td class="sales-value">
                                    <t t-esc="state.currency.symbol"/> <t t-esc="s.sales"/>
                                </td>

                            </tr>

                        </t>

                    </tbody>

                </table>

            </div>

        </div>

    </t>

    <!-- product category popup -->
    <t t-if="state.showCategoryPopup">

        <div class="session-popup-overlay">

            <div class="session-popup">

                <div class="popup-header">
                    Top Categories
                    <button class="popup-close" t-on-click="closeCategoryPopup">✕</button>
                </div>

                <table class="modern-table">

                    <thead>
                        <tr>
                            <th>S.No.</th>
                            <th>Category</th>
                            <th>Qty</th>
                        </tr>
                    </thead>

                    <tbody>
                        <t t-set="tcs_sno" t-value="1"/>
                        <t t-foreach="state.categories.slice(5)" t-as="cat" t-key="cat.id">

                            <tr>
                                <td>
                                    <t t-esc="tcs_sno"/>
                                </td>
                                <td>
                                    <t t-esc="cat.name"/>
                                </td>

                                <td>
                                    <span class="qty-pill">
                                        <t t-esc="cat.qty"/>
                                    </span>
                                </td>

                            </tr>
                            <t t-set="tcs_sno" t-value="tcs_sno + 1"/>

                        </t>

                    </tbody>

                </table>

            </div>

        </div>

    </t>


    <!-- product category related product popup -->

    <t t-if="state.showCategoryProducts">

        <div class="session-popup-overlay"
           t-on-click="closeCategoryProducts">

           <div class="session-popup"
               t-on-click.stop="">

               <div class="popup-header">

                <span>Category Products</span>

                <button class="popup-close"
                    t-on-click="closeCategoryProducts">
                    ✕
                </button>

            </div>

            <table class="modern-table">

                <thead>
                    <tr>
                        <th>S.No.</th>
                        <th>Product</th>
                        <th>Qty</th>
                    </tr>
                </thead>

                <tbody>
                    <t t-set="sp_sno" t-value="1"/>
                    <t t-foreach="state.category_products"
                     t-as="p"
                     t-key="p.id">

                     <tr>

                        <td>
                            <t t-esc="sp_sno"/>
                        </td>

                        <td>
                            <t t-esc="p.name"/>
                        </td>

                        <td>
                            <span class="qty-pill">
                                <t t-esc="p.qty"/>
                            </span>
                        </td>

                    </tr>
                    <t t-set="sp_sno" t-value="sp_sno + 1"/>

                </t>

            </tbody>

        </table>

    </div>

</div>

</t>
<!-- Customer popup -->

<t t-if="state.showCustomerPopup">

    <div class="session-popup-overlay"
       t-on-click="closeCustomerPopup">

       <div class="session-popup"
           t-on-click.stop="">

           <div class="popup-header">

            <span> Top Customers</span>

            <button class="popup-close"
                t-on-click="closeCustomerPopup">
                ✕
            </button>

        </div>

        <table class="modern-table">

            <thead>
                <tr>
                    <th>S.No.</th>
                    <th>Customer</th>
                    <th>Sales</th>
                </tr>
            </thead>

            <tbody>
                <t t-set="tc_sno" t-value="1"/>
                <t t-foreach="state.customers.slice(5)" t-as="c" t-key="c[0] + '_' + c_index">

                    <tr>

                        <td><t t-esc="tc_sno"/></td>

                        <!-- CUSTOMER WITH IMAGE -->
                        <td style="display:flex; align-items:center; gap:10px;">

                            <div class="customer-img-wrapper">

                                <img t-att-src="'/web/image/res.partner/' + c[0] + '/image_128'"
                                   class="customer-avatar"/>

                                   <!-- ZOOM IMAGE -->
                                   <img t-att-src="'/web/image/res.partner/' + c[0] + '/image_128'"
                                       class="customer-zoom"/>

                                   </div>

                                   <span>
                                    <t t-esc="c[1]"/>
                                </span>

                            </td>

                            <td class="sales-value">
                                <t t-esc="state.currency.symbol"/> <t t-esc="c[2]"/>
                            </td>

                        </tr>
                        <t t-set="tc_sno" t-value="tc_sno + 1"/>

                    </t>

                </tbody>

            </table>

        </div>

    </div>

</t>


<!-- CASHIER POPUP -->

<t t-if="state.showCashierPopup">

    <div class="session-popup-overlay"
         t-on-click="closeCashierPopup">

        <div class="session-popup"
             t-on-click.stop="">

            <div class="popup-header">

                <span>Top Cashiers</span>

                <button class="popup-close"
                        t-on-click="closeCashierPopup">
                    ✕
                </button>

            </div>

            <table class="modern-table">

                <thead>
                    <tr>
                        <th>Rank</th>
                        <th>Cashier</th>
                        <th>Orders</th>
                        <th>Sales</th>
                    </tr>
                </thead>

                <tbody>

                    <t t-foreach="state.top_cashiers.slice(5)" t-as="c" t-key="c.id">

                        <tr>

                            <td><t t-esc="c.rank"/></td>

                            <td style="display:flex; align-items:center; gap:10px;">

                                <div class="customer-img-wrapper">

                            <!-- Small image -->
                            <img t-att-src="'/web/image/hr.employee/' + c.id + '/image_128'"
                                 class="customer-avatar"/>

                            <!-- Zoom image -->
                            <img t-att-src="'/web/image/hr.employee/' + c.id + '/image_128'"
                                 class="customer-zoom"/>

                        </div>
                                <span><t t-esc="c.name"/></span>
                            </td>

                            <td>
                                <t t-esc="c.orders"/>
                            </td>

                            <td class="sales-value">
                                <t t-esc="state.currency.symbol"/> 
                                <t t-esc="c.sales"/>
                            </td>

                        </tr>

                    </t>

                </tbody>

            </table>

        </div>

    </div>

</t>

<!-- Payment Details popup -->

<t t-if="state.showPaymentPopup">

    <div class="session-popup-overlay"
         t-on-click="closePaymentPopup">

        <div class="session-popup"
             t-on-click.stop="">

            <div class="popup-header">

                <span>
                    <t t-esc="state.selectedPaymentMethod"/> Details
                </span>

                <button class="popup-close"
                        t-on-click="closePaymentPopup">
                    ✕
                </button>

            </div>

            <table class="modern-table">

                <thead>
                    <tr>
                        <th>Store</th>
                        <th>Orders</th>
                        <th>Amount</th>
                    </tr>
                </thead>

                <tbody>

                    <t t-foreach="state.paymentDetails"
                       t-as="p"
                       t-key="p.store">

                        <tr>

                            <td>
                                <t t-esc="p.store"/>
                            </td>

                            <td>
                                <t t-esc="p.orders"/>
                            </td>

                            <td class="sales-value">
                                <t t-esc="state.currency.symbol"/>
                                <t t-esc="p.amount"/>
                            </td>

                        </tr>

                    </t>

                </tbody>

            </table>

        </div>

    </div>

</t>


</div>

</t>

</templates>
