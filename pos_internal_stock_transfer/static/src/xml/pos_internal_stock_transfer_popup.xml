<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

<t t-name="pos_internal_stock_transfer.SendStockPopup">
    <Dialog title="props.title">

        <div class="p-3">
            <h4>
                From : <t t-esc="props.configName"/>
            </h4>

            <div class="mt-3">
                <label>Send To </label>
                <select t-model="state.wareValue" class="form-control">
                    <option value="">Select Warehouse</option>
                    <t t-foreach="props.warehouses" t-as="w" t-key="w.id">
                        <option t-att-value="w.id">
                            <t t-esc="w.name"/>
                        </option>
                    </t>
                </select>
            </div>
        </div>

        <t t-set-slot="footer">
            <button class="btn btn-primary" t-on-click="action_confirm">
                Confirm
            </button>
            <button class="btn btn-secondary" t-on-click="action_cancel">
                Cancel
            </button>
        </t>

    </Dialog>
</t>

</templates>