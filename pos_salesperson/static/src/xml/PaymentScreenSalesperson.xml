<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="PaymentScreen" t-inherit="point_of_sale.PaymentScreenButtons" t-inherit-mode="extension" owl="1">
        <xpath expr="//button[@class='button partner-button btn btn-lg w-100 w-md-50 lh-lg text-truncate']" position="after">
            <t t-if="pos.config.salesperson_compulsory">
                <button class="button btn btn-lg w-100 w-md-50 lh-lg text-truncate"
                    t-att-class="{ 'highlight': currentOrder.get_salesperson() }"
                    t-attf-class="{{ currentOrder.get_salesperson() ? 'btn-primary' : 'btn-secondary' }}"
                    t-on-click="selectSalesperson">

                    <i class="fa fa-user me-2" role="img" title="Salesperson" />

                    <span class="partner-name">
                        <t t-if="currentOrder.get_salesperson()"
                         t-esc="currentOrder.get_salesperson().name"/>
                         <t t-else="">Salesperson</t>
                     </span>

                 </button>
            </t>

         </xpath>
     </t>
 </templates>


