<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <record id="email_template_login_otp" model="mail.template">
            <field name="name">Login OTP Code</field>
            <field name="model_id" ref="model_login_otp"/>
            <field name="subject">Your Login Verification Code</field>
            <field name="email_to">{{ object.email }}</field>
            <field name="auto_delete" eval="True"/>

            <field name="body_html" type="html">
                <div style="margin:0; padding:40px 15px; background-color:#f4f6f8; font-family:Arial, Helvetica, sans-serif;">

                    <div style="max-width:600px; margin:0 auto; background-color:#ffffff; border-radius:14px; overflow:hidden; border:1px solid #e6e9ed;">

                        <!-- HEADER -->
                        <div style="padding:28px 30px; text-align:center; background-color:#ffffff; border-bottom:1px solid #eeeeee;">

                            <!-- Company Logo -->
                            <t t-if="res_company and res_company.logo">
                                <img
                                    t-att-src="'data:image/png;base64,%s' % res_company.logo.decode('utf-8')"
                                    t-att-alt="res_company.name"
                                    style="max-width:180px; max-height:70px; display:block; margin:0 auto;"
                                />
                            </t>

                            <t t-else="">
                                <div style="font-size:22px; font-weight:bold; color:#202124;">
                                    <t t-out="res_company.name or 'Company'"/>
                                </div>
                            </t>

                        </div>

                        <!-- CONTENT -->
                        <div style="padding:40px 40px 35px; text-align:center;">

                            <!-- Security Icon -->
                            <div style="width:58px; height:58px; margin:0 auto 22px; border-radius:50%; background-color:#eef4ff; text-align:center; line-height:58px;">
                                <span style="font-size:26px;">🔐</span>
                            </div>

                            <!-- TITLE -->
                            <h2 style="margin:0 0 12px; font-size:24px; line-height:32px; font-weight:700; color:#202124;">
                                Verify Your Login
                            </h2>

                            <p style="margin:0 0 10px; font-size:15px; line-height:24px; color:#555555;">
                                Hello,
                            </p>

                            <p style="margin:0 auto 28px; max-width:450px; font-size:15px; line-height:24px; color:#666666;">
                                Use the verification code below to securely complete your login.
                            </p>

                            <!-- OTP -->
                            <div style="display:inline-block; min-width:220px; padding:18px 28px; margin:0 auto 25px; background-color:#f7f9fc; border:1px solid #e2e6eb; border-radius:10px;">

                                <div style="margin-bottom:7px; font-size:11px; font-weight:bold; letter-spacing:1.5px; text-transform:uppercase; color:#8a9199;">
                                    Verification Code
                                </div>

                                <div style="font-size:32px; line-height:40px; font-weight:700; letter-spacing:8px; color:#202124;">
                                    <t t-out="ctx.get('otp_code')"/>
                                </div>

                            </div>

                            <!-- EXPIRY -->
                            <p style="margin:0 auto 20px; font-size:14px; line-height:22px; color:#666666;">
                                This code expires in
                                <strong style="color:#202124;">
                                    <t t-out="ctx.get('otp_validity_minutes')"/>
                                    minutes
                                </strong>.
                            </p>

                            <!-- SECURITY NOTICE -->
                            <div style="margin-top:25px; padding:15px 18px; background-color:#fff8e6; border:1px solid #f5df9b; border-radius:8px; text-align:left;">

                                <div style="font-size:13px; line-height:20px; color:#665522;">
                                    <strong>Security notice:</strong>
                                    Never share this verification code with anyone.
                                    Our team will never ask you for your OTP.
                                </div>

                            </div>

                            <!-- IGNORE -->
                            <p style="margin:25px 0 0; font-size:13px; line-height:20px; color:#999999;">
                                If you did not request this login code, you can safely ignore this email.
                            </p>

                        </div>

                        <!-- FOOTER -->
                        <div style="padding:20px 30px; text-align:center; background-color:#f8f9fa; border-top:1px solid #eeeeee;">

                            <p style="margin:0 0 5px; font-size:12px; color:#777777;">
                                ©
                                <t t-out="res_company.name or 'Company'"/>
                            </p>

                            <p style="margin:0; font-size:11px; color:#aaaaaa;">
                                This is an automated security email. Please do not reply.
                            </p>

                        </div>

                    </div>

                </div>
            </field>
        </record>

    </data>
</odoo>